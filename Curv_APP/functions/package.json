{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/branding/logoFile.node-test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
